# Konfiguracja dla `docker compose up` — JEDYNE źródło środowiska kontenerów.
# Plik jest w .gitignore; szablon do repo to .env.docker.example.
# Zwykły .env służy wyłącznie do uruchamiania bez Dockera (uvicorn z terminala).

# W kontenerach zawsze PostgreSQL składany z części POSTGRES_*.
ENV=dev

# Te same zmienne czyta obraz postgres (inicjalizacja bazy) i API (połączenie).
# POSTGRES_HOST to nazwa usługi w sieci compose, nie localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=miplo
POSTGRES_USER=miplo
POSTGRES_PASSWORD=miplo_local_only

DB_ECHO=false

# Ścieżka WEWNĄTRZ kontenera api; compose montuje tu ./secrets/firebase-admin-dev.json.
FIREBASE_ADMIN_CREDENTIALS=/run/secrets/firebase-admin.json

# Firebase Storage (nazwa bucketa, NIE URL — bez prefiksu gs://).
# PUSTE = uploady (avatar, okładki, GLB) będą się wywalać w runtime.
FIREBASE_STORAGE_BUCKET=

# CORS (rozdzielane przecinkami)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173
# "api" to hostname usługi w sieci compose (healthchecki i ruch między kontenerami).
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Rate limiting — Redis z compose (nazwa usługi, nie localhost).
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
GLOBAL_IP_RATE_LIMIT=120/minute

# BGG API (token z boardgamegeek.com/applications — puste = dev mode,
# endpointy cache-only działają, endpointy odpytujące BGG zwracają bgg_not_configured)
BGG_API_BASE=https://boardgamegeek.com/xmlapi2
BGG_API_TOKEN=
BGG_CACHE_TTL_SECONDS=2592000
BGG_MAX_CONCURRENT=2
BGG_MIN_REQUEST_INTERVAL=5.0
BGG_REFRESH_COOLDOWN=60
BGG_MAX_PENDING_REFRESHES=32

# Cloud Run Job / python -m services.scripts.nightly_sync
NIGHTLY_SYNC_BUDGET=1800
NIGHTLY_SYNC_LEVEL1_LIMIT=200
NIGHTLY_SYNC_LEVEL2_LIMIT=100

# Ochrona CPU/RAM przy generowaniu modeli GLB
MODEL_GENERATION_CONCURRENCY=1
MODEL_GENERATION_TIMEOUT_SECONDS=90

# Uniwersalny sekret wszystkich operacji /api/admin/*, w tym importu BGG.
# Minimum 32 znaki; nigdy nie umieszczaj go w aplikacji frontendowej.
ADMIN_API_KEY=change-me-to-another-long-random-secret
