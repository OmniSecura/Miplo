# Skopiuj do .env i uzupełnij. Prawdziwy .env jest w .gitignore.
# Na produkcji wartości pochodzą z GCP Secret Manager, nie z pliku.

# Baza
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/miplo

# Firebase (ścieżka do klucza admina — plik NIE trafia do repo)
FIREBASE_ADMIN_CREDENTIALS=/secrets/firebase-admin.json

# BGG
BGG_API_BASE=https://boardgamegeek.com/xmlapi2
BGG_CACHE_TTL_SECONDS=86400

# Redis (cache BGG)
REDIS_URL=redis://localhost:6379/0

# Środowisko
ENV=dev
