# Skopiuj do .env i uzupełnij. Prawdziwy .env jest w .gitignore.
# Na produkcji wartości pochodzą z GCP Secret Manager, nie z pliku.

# Środowisko: local | dev | prod — steruje wyborem bazy
#   local → SQLite (plik tworzy się sam przy starcie)
#   dev   → PostgreSQL składany z części POSTGRES_*
#   prod  → PostgreSQL z gotowego DATABASE_URL (Secret Manager)
ENV=local

# ENV=local
SQLITE_PATH=local.db

# ENV=dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=miplo
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# ENV=prod — sterownik psycopg3, prefix postgresql+psycopg:// jest wymagany
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/miplo

DB_ECHO=false

# Firebase (ścieżka do klucza admina — plik NIE trafia do repo)
FIREBASE_ADMIN_CREDENTIALS=/secrets/firebase-admin.json

# Firebase Storage (nazwa bucketa, NIE URL — bez prefiksu gs://)
FIREBASE_STORAGE_BUCKET=miplo-dev.firebasestorage.app

# CORS (rozdzielane przecinkami)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173
# Host header allowlist; na prod wpisz domenę API i host Cloud Run.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Rate limiting — dev: pamięć procesu; prod: redis://... (wspólne liczniki instancji)
RATE_LIMIT_STORAGE_URI=memory://
# Awaryjny limit per IP działa przed routingiem, auth i walidacją payloadu.
GLOBAL_IP_RATE_LIMIT=120/minute

# BGG API (token z boardgamegeek.com/applications — puste = dev mode,
# endpointy cache-only działają, endpointy odpytujące BGG zwracają bgg_not_configured)
BGG_API_BASE=https://boardgamegeek.com/xmlapi2
BGG_API_TOKEN=
BGG_CACHE_TTL_SECONDS=86400

# Ochrona CPU/RAM przy generowaniu modeli GLB
MODEL_GENERATION_CONCURRENCY=1
MODEL_GENERATION_TIMEOUT_SECONDS=90

# Operatorski sekret dla POST /api/games/import (wygeneruj losowe 32+ bajty)
GAMES_IMPORT_KEY=change-me-to-a-long-random-secret

# Uniwersalny sekret panelu moderacji (/api/admin/moderation/*).
# Minimum 32 znaki; używany wyłącznie serwer-serwer lub ręcznie w Swaggerze
# jako nagłówek X-Admin-Key. Nigdy nie umieszczaj go w aplikacji frontendowej.
ADMIN_API_KEY=change-me-to-another-long-random-secret
